#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service()
{
	config_load sms-feishu-forwarder
	local enabled
	config_get_bool enabled settings enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/sms-feishu-forwarder
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers()
{
	procd_add_reload_trigger sms-feishu-forwarder
}
