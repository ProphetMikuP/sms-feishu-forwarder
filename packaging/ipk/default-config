config settings 'settings'
	option enabled '0'
	option poll_interval '10'
	option settle_delay '0'
	option attach_status '1'
	option scheduler_active '1'
	option state_path '/var/lib/sms-feishu-forwarder/seen.keys'
	option modem_status_path '/var/lib/sms-feishu-forwarder/modem-status.json'
	option quota_calibration 'off'
	option quota_state_path '/var/lib/sms-feishu-forwarder/quota-state.json'
	option quota_status_path '/var/lib/sms-feishu-forwarder/quota-status.json'
	option schedule_state_dir '/etc/sms-feishu-forwarder/schedule-state'

config schedule 'traffic_hourly'
	option enabled '0'
	option name 'traffic_hourly'
	option recipient '10086'
	option content 'CXLL'
	option hour '*'
	option minute '0'
	option weekdays '*'

config schedule 'balance_daily'
	option enabled '0'
	option name 'balance_daily'
	option recipient '10086'
	option content 'CXYE'
	option hour '9'
	option minute '5'
	option weekdays '*'
