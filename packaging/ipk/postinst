#!/bin/sh
set -eu

ROOT="${SMSFF_PACKAGE_ROOT:-${IPKG_INSTROOT:-}}"
target()
{
	if [ -n "$ROOT" ]; then
		printf '%s/%s' "${ROOT%/}" "$1"
	else
		printf '/%s' "$1"
	fi
}

CONFIG="$(target etc/config/sms-feishu-forwarder)"
TEMPLATE="$(target usr/share/sms-feishu-forwarder/default-config)"
SECRET_CONFIG="$(target etc/config/smsforward)"

if [ ! -e "$CONFIG" ]; then
	mkdir -p "$(target etc/config)"
	cp "$TEMPLATE" "$CONFIG"
fi
chmod 600 "$CONFIG"

if [ ! -e "$SECRET_CONFIG" ]; then
	mkdir -p "$(target etc/config)"
	umask 077
	printf '%s\n' "config settings 'settings'" > "$SECRET_CONFIG"
fi
chmod 600 "$SECRET_CONFIG"

[ -n "${IPKG_INSTROOT:-}" ] && exit 0

INIT_CMD="${SMSFF_PACKAGE_INIT_CMD:-$(target etc/init.d/sms-feishu-forwarder)}"
RPCD_INIT_CMD="${SMSFF_PACKAGE_RPCD_INIT_CMD:-$(target etc/init.d/rpcd)}"
STATE_FILE="$(target etc/sms-feishu-forwarder)/package-service-state"

desired_enabled=''
desired_running=''
if [ -f "$STATE_FILE" ]; then
	desired_enabled="$(sed -n 's/^enabled=//p' "$STATE_FILE" | sed -n '1p')"
	desired_running="$(sed -n 's/^running=//p' "$STATE_FILE" | sed -n '1p')"
else
	desired_enabled="$(sed -n "s/^[[:space:]]*option[[:space:]]\+enabled[[:space:]]*'\([^']*\)'.*/\1/p" "$CONFIG" | sed -n '1p')"
	[ "$desired_enabled" = '1' ] || desired_enabled='0'
	desired_running="$desired_enabled"
fi
case "$desired_enabled:$desired_running" in
	0:0|0:1|1:0|1:1) ;;
	*) exit 1 ;;
esac

verify_service_state()
{
	if [ ! -x "$INIT_CMD" ]; then
		[ "$desired_enabled:$desired_running" = '0:0' ] || return 1
		return 0
	fi
	if [ "$desired_enabled" = '1' ]; then
		"$INIT_CMD" enabled >/dev/null 2>&1
	else
		if "$INIT_CMD" enabled >/dev/null 2>&1; then
			return 1
		fi
	fi
	if [ "$desired_running" = '1' ]; then
		"$INIT_CMD" running >/dev/null 2>&1
	else
		if "$INIT_CMD" running >/dev/null 2>&1; then
			return 1
		fi
	fi
}

rm -f /tmp/luci-indexcache /tmp/luci-modulecache/* 2>/dev/null || true
if [ -x "$RPCD_INIT_CMD" ]; then
	"$RPCD_INIT_CMD" restart >/dev/null 2>&1
fi

if [ "$desired_enabled" = '1' ]; then
	[ -x "$INIT_CMD" ] || exit 1
	"$INIT_CMD" enable >/dev/null 2>&1
else
	if [ -x "$INIT_CMD" ]; then
		"$INIT_CMD" disable >/dev/null 2>&1
	fi
fi

if [ "$desired_running" = '1' ]; then
	[ -x "$INIT_CMD" ] || exit 1
	"$INIT_CMD" restart >/dev/null 2>&1
else
	if [ -x "$INIT_CMD" ]; then
		"$INIT_CMD" stop >/dev/null 2>&1
	fi
fi

verify_service_state

exit 0
